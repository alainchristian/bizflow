PORT=3000

# Host port is 5433, not 5432 -- avoids clashing with a locally installed Postgres, if any.
#
# DATABASE_URL is what the running app connects as: the restricted
# `bizflow_app` role (created by the CreateAppRole migration), which does
# NOT bypass Row-Level Security. MIGRATION_DATABASE_URL is the DB
# owner/superuser connection the migration CLI uses to run schema DDL
# (including creating that role in the first place) -- see
# src/database/migrations/*-CreateAppRole.ts for why the split exists.
DATABASE_URL=postgres://bizflow_app:bizflow_app_dev_password@localhost:5433/bizflow
MIGRATION_DATABASE_URL=postgres://bizflow:bizflow@localhost:5433/bizflow
REDIS_URL=redis://localhost:6379

# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-0123456789
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
